{
  "name": "lpws",
  "version": "0.1.0",
  "private": true,
  "description": "LPWS — infrastructure de landing pages pour media buyers : clone, structure, variante, déploiement.",
  "type": "module",
  "scripts": {
    "clone": "tsx engine/clone/run.ts",
    "styles": "tsx engine/clone/2_styles/localize.ts",
    "assets": "tsx engine/clone/3_assets/localize.ts",
    "verify": "tsx engine/clone/5_verify/verify.ts",
    "corpus": "tsx engine/clone/corpus.ts",
    "apply": "tsx engine/apply/run.ts",
    "aller-retour": "tsx engine/apply/aller-retour.ts",
    "rejouer": "tsx engine/apply/rejouer.ts",
    "viewer": "tsx engine/viewer/server.ts",
    "relink": "tsx engine/clone/1_acquire/relink-cli.ts",
    "relink:check": "tsx engine/clone/1_acquire/relink-check.ts",
    "deploy": "tsx engine/deploy/run.ts",
    "tag": "tsx engine/deploy/tag/build.ts",
    "tag:check": "tsx engine/deploy/tag/check.ts",
    "lcp": "tsx engine/deploy/tag/lcp.ts",
    "intents": "tsx engine/intent/run.ts",
    "ui": "tsx ui/build.ts",
    "ui:serve": "tsx ui/server.ts",
    "ui:deploy": "tsx ui/build.ts && cd ui/dist && vercel deploy --prod --yes",
    "measure": "tsx engine/measure/run.ts",
    "brain": "tsx engine/variant/run.ts",
    "brain:eval": "tsx engine/variant/eval.ts",
    "test": "tsx --test \"engine/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "audit": "tsx engine/audit/audit.ts",
    "surveille": "tsx engine/surveille/surveille.ts",
    "couts": "tsx engine/compte/couts.ts",
    "menage": "tsx scripts/menage.ts && knip"
  },
  "dependencies": {
    "esbuild": "~0.28.2",
    "pixelmatch": "^7",
    "playwright": "^1.55",
    "pngjs": "^7",
    "tsx": "^4",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pngjs": "^6",
    "knip": "~6.37.0",
    "typescript": "^5"
  },
  "knip": {
    "entry": [
      "engine/intent/ads-script.js"
    ],
    "project": [
      "engine/**/*.{ts,js}",
      "ui/**/*.ts",
      "scripts/**/*.ts"
    ],
    "ignoreExportsUsedInFile": true,
    "ignoreBinaries": [
      "vercel"
    ]
  }
}
